generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  orders Order[]

  makerFills Fills[] @relation("maker")
  takerFills Fills[] @relation("taker")
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  marketId       String
  type           OrderType
  side           OrderSide
  price          Int
  quantity       Int
  filledQuantity Int
  status         OrderStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  makerFills Fills[] @relation("makerOrder")
  takerFills Fills[] @relation("takerOrder")

  user User @relation(fields: [userId], references: [id])

  market Market @relation(fields: [marketId], references: [id])
}

model Fills {
  id           String @id @default(uuid())
  makerUserId  String
  takerUserId  String
  makerOrderId String
  takerOrderId String
  marketId     String
  price        Int
  quantity     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  makerUser  User   @relation("maker", fields: [makerUserId], references: [id])
  takerUser  User   @relation("taker", fields: [takerUserId], references: [id])
  makerOrder Order  @relation("makerOrder", fields: [makerOrderId], references: [id])
  takerOrder Order  @relation("takerOrder", fields: [takerOrderId], references: [id])
  market     Market @relation(fields: [marketId], references: [id])
}

model Market {
  id         String @id @default(uuid())
  marketSlug String @unique
  imageUrl   String

  orders Order[]
  fills  Fills[]
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderSide {
  LONG
  SHORT
}

enum OrderStatus {
  Open
  Filled
  PartiallyFilled
  Cancelled
}
