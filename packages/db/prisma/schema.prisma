generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  orders Order[]

  makerFills Fills[] @relation("maker")
  takerFills Fills[] @relation("taker")

  balance      Balance?
  positions    Position[]
  liquidations Liquidation[]
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  marketId       String
  type           OrderType
  side           OrderSide
  price          String?
  quantity       String
  filledQuantity String
  status         OrderStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  makerFills Fills[] @relation("makerOrder")
  takerFills Fills[] @relation("takerOrder")

  user User @relation(fields: [userId], references: [id])

  market Market @relation(fields: [marketId], references: [id])
}

model Fills {
  id           String @id @default(uuid())
  makerUserId  String
  takerUserId  String
  makerOrderId String
  takerOrderId String
  marketId     String
  price        String
  quantity     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  makerUser  User   @relation("maker", fields: [makerUserId], references: [id])
  takerUser  User   @relation("taker", fields: [takerUserId], references: [id])
  makerOrder Order  @relation("makerOrder", fields: [makerOrderId], references: [id])
  takerOrder Order  @relation("takerOrder", fields: [takerOrderId], references: [id])
  market     Market @relation(fields: [marketId], references: [id])
}

model Market {
  id         String  @id @default(uuid())
  marketSlug String  @unique
  imageUrl   String?

  orders Order[]
  fills  Fills[]

  positions    Position[]
  liquidations Liquidation[]
}

model Balance {
  id        String   @id @default(uuid())
  userId    String
  available String
  locked    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model Position {
  id               String    @id @default(uuid())
  userId           String
  marketId         String
  side             OrderSide
  quantity         String
  averagePrice     String
  liquidationPrice String
  margin           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
  market           Market    @relation(fields: [marketId], references: [id])

  @@index([userId, marketId])
}

model Liquidation {
  id               String   @id @default(uuid())
  userId           String
  marketId         String
  quantity         String
  bankruptcyPrice  String
  liquidationPrice String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
  market           Market   @relation(fields: [marketId], references: [id])

  @@index([userId])
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderSide {
  LONG
  SHORT
}

enum OrderStatus {
  Open
  Filled
  PartiallyFilled
  Cancelled
}
