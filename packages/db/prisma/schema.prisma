generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  orders Order[]
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  marketId       String
  type           OrderType
  side           OrderSide
  price          Int
  quantity       Int
  filledQuantity Int
  status         OrderStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  market Market @relation(fields: [marketId], references: [id])
}

model Market {
  id         String @id @default(uuid())
  marketSlug String @unique
  imageUrl   String

  orders Order[]
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderSide {
  LONG
  SHORT
}

enum OrderStatus {
  Open
  Filled
  Partial
  Cancelled
}
